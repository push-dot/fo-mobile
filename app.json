{
  "expo": {
    "name": "Push",
    "slug": "push",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.push.mobile",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "icon": {
        "light": "./assets/icons/ios-light.png",
        "dark": "./assets/icons/ios-dark.png",
        "tinted": "./assets/icons/ios-tinted.png"
      },
      "deploymentTarget": "17.0"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#16191D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.push.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-image",
      "expo-notifications",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/NotoSansKR-Regular.ttf",
            "./assets/fonts/NotoSansKR-Medium.ttf",
            "./assets/fonts/NotoSansKR-SemiBold.ttf",
            "./assets/fonts/NotoSansKR-Bold.ttf",
            "./assets/fonts/NotoSansKR-ExtraBold.ttf"
          ]
        }
      ],
      "expo-sharing",
      "expo-apple-authentication",
      "expo-iap",
      "expo-splash-screen",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 37
          }
        }
      ],
      "./modules/push-a2ui/app.plugin.js"
    ],
    "scheme": "push",
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "2e6ac5f6-3628-49f6-bff3-aecbe809308b"
      }
    },
    "owner": "cyjoon"
  }
}
